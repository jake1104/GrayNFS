    n: int,
    *,
    degree: int | None = ...,
    rational_base_bound: int = ...,
    algebraic_base_bound: int = ...,
    sieve_a_bound: int = ...,
    sieve_b_bound: int = ...,
    timeout_seconds: int | None = ...,
    max_memory_mb: int | None = ...,
    allow_fallback: bool = ...,
    use_fermat: bool = ...,
    use_squfof: bool = ...,
    use_pm1: bool = ...,
    use_pp1: bool = ...,
    use_ecm: bool = ...,
    use_mpqs: bool = ...,
    threads: int | None = ...,
    perf_mode: bool = ...,
    skip_preprocessing: bool = ...,
    large_prime_bound: int = ...,
    enable_double_large_primes: bool = ...,
    seed: int | None = ...,
) -> list[int]: ...
